# =====================================================================
# Copy to .env and fill in. .env is gitignored — no secret belongs in git.
#
# API keys and SMTP passwords are NOT set here: they live in n8n's own
# encrypted credential store. This file configures the containers.
# =====================================================================

# --- n8n -------------------------------------------------------------
# Generate once and BACK IT UP. Lose it and every stored credential
# becomes permanently unreadable:  openssl rand -hex 32
N8N_ENCRYPTION_KEY=

# Public URL of this n8n instance. Webhook URLs are built from it, and
# the unsubscribe link in every email depends on it being correct.
N8N_HOST=n8n.yourdomain.tld
N8N_PROTOCOL=https
WEBHOOK_URL=https://n8n.yourdomain.tld/

# Cron expressions in the workflows mean local time in this zone.
GENERIC_TIMEZONE=Asia/Karachi

# Basic auth on the n8n UI. Better still, keep the UI off the public
# internet entirely and reach it over SSH or a VPN.
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=umer
N8N_BASIC_AUTH_PASSWORD=

# --- acquisition database --------------------------------------------
# Same Postgres server as Clinibot, separate database, separate role.
# See docs/00-architecture-audit.md finding 9.
ACQ_POSTGRES_HOST=postgres
ACQ_POSTGRES_PORT=5432
ACQ_POSTGRES_DB=zenvexa_acq
ACQ_POSTGRES_USER=acq_app
ACQ_POSTGRES_PASSWORD=

# Used by the dashboard and by Prisma. Not read by n8n, which uses its
# own credential.
ACQ_DATABASE_URL=postgresql://acq_app:CHANGEME@localhost:5432/zenvexa_acq?schema=acq

# --- local development only -------------------------------------------
# Password for the throwaway Postgres in the `dev` compose profile.
# Never point this at a real database.
DEV_POSTGRES_PASSWORD=devonly
