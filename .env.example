# =====================================================================
# Copy to .env and fill in. .env is gitignored — no secret belongs in git.
#
# Three places hold configuration now, and only this file is local:
#
#   this file      migration + prompt loading from your laptop
#   n8n            API keys and SMTP live in n8n's encrypted credential store
#   Vercel         the dashboard's environment variables
#
# =====================================================================

# --- Supabase --------------------------------------------------------
# Project settings -> Database -> Connection string. Read the values off the
# dashboard rather than assembling them by hand; hostnames and ports differ
# per region and do change.
#
# THREE different connection strings, for three different jobs:
#
#   SUPABASE_ADMIN_URL      DDL. Used only by ops/migrate-supabase.sh, only
#                           from your laptop. Never deployed anywhere.
#   n8n   -> SESSION pooler (port 5432 on the pooler host), as acq_n8n
#   Vercel-> TRANSACTION pooler (port 6543), as acq_dashboard
#
# Use the POOLER host for n8n and Vercel, not the direct `db.<ref>.supabase.co`
# one: direct connections are IPv6-only on the free tier, and a DigitalOcean
# droplet usually cannot reach them.

# Admin/DDL connection — Supabase's `postgres` role.
SUPABASE_ADMIN_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Passwords you assign to the two least-privilege roles from migration 010.
# The migration creates both WITHOUT a password, so neither can connect until
# you run, as the admin role:
#   ALTER ROLE acq_n8n       PASSWORD '…';
#   ALTER ROLE acq_dashboard PASSWORD '…';
# Generate with: openssl rand -base64 24
ACQ_N8N_PASSWORD=
ACQ_DASHBOARD_PASSWORD=

# --- n8n (already deployed on DigitalOcean) --------------------------
# Public HTTPS base URL of your n8n. The unsubscribe link in every email is
# built from this, and it must resolve from the open internet — a dead opt-out
# link is worse than no link at all.
N8N_PUBLIC_URL=https://n8n.yourdomain.tld

# Where n8n runs. Any of these; ops/docker-compose.n8n.yml serves all three:
#   ops/oracle/          Oracle Cloud Always Free (arm64, genuinely free)
#   a $6 DO droplet      1 GB — enough, since only n8n runs on it
#   the existing droplet a second container beside Clinibot's n8n
#
# Let's Encrypt needs this; Caddy will not start without it.
ACME_EMAIL=

# Pin the n8n image in production. `latest` means an unattended `up` can swap
# the engine under thirteen working workflows; check_n8n_env.sh exists because
# n8n does remove environment variables between releases.
N8N_VERSION=latest

# Container ceiling and Node heap, so a runaway execution restarts one
# container instead of letting the OOM killer pick a victim. Defaults suit a
# 1 GB host. On an Oracle A1 with 6 GB, raise them:
#   N8N_MEM_LIMIT=2g
#   N8N_HEAP_MB=1536
N8N_MEM_LIMIT=700m
N8N_HEAP_MB=512

# Execution-history retention, in hours. The loops in workflows 10, 30 and 50
# generate a lot; this is n8n's own SQLite, not Supabase.
N8N_EXEC_MAX_AGE=336

# In n8n, the `acq-postgres` credential points at the SESSION pooler as
# acq_n8n, with SSL required:
#   host     aws-0-<region>.pooler.supabase.com
#   port     5432
#   database postgres
#   user     acq_n8n.<project-ref>
#   ssl      require
#
# Cron expressions in the workflows mean local time in this zone.
GENERIC_TIMEZONE=Asia/Karachi

# --- dashboard (Vercel) ----------------------------------------------
# Set these in Vercel's project environment variables, not here — this block
# documents what Vercel needs. Nothing prefixed NEXT_PUBLIC_ is secret; it is
# compiled into the browser bundle, so never put a database URL there.
#
#   ACQ_DATABASE_URL              transaction pooler (:6543), as acq_dashboard
#   NEXT_PUBLIC_SUPABASE_URL      https://<ref>.supabase.co
#   NEXT_PUBLIC_SUPABASE_ANON_KEY the anon key (safe in the browser)
#   NEXT_PUBLIC_SITE_URL          https://<your-app>.vercel.app
#   ACQ_ALLOWED_EMAILS            comma-separated allowlist. NOT optional —
#                                 empty denies everyone, by design.
#
# Locally, for `npm run dev` in dashboard/:
ACQ_DATABASE_URL=postgresql://acq_dashboard.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
NEXT_PUBLIC_SUPABASE_URL=https://<ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SITE_URL=http://localhost:3001
ACQ_ALLOWED_EMAILS=you@yourdomain.tld

# --- local development only -------------------------------------------
# Throwaway Postgres for running the test suite. Never a real database.
DEV_POSTGRES_PASSWORD=devonly

# --- WhatsApp API (WAHA, migration 015) -------------------------------
# Generate each with: openssl rand -hex 24
WAHA_API_KEY=
WAHA_DASHBOARD_PASSWORD=
# Header value WAHA sends to workflow 48 and n8n's waha-webhook-secret checks.
WAHA_WEBHOOK_SECRET=
