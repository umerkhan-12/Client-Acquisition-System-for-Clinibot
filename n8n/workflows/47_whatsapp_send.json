{
  "name": "ACQ 47 \u2014 WhatsApp Sender",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "*/2 * * * *"
            }
          ]
        }
      },
      "id": "wf47-00",
      "name": "Every 2 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        260,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM acq.claim_whatsapp_send($1) WHERE reason = 'claimed'",
        "options": {
          "queryReplacement": "={{ [ 'wf47:' + $execution.id ] }}"
        }
      },
      "id": "wf47-01",
      "name": "Claim Next Message",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        480,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_PG",
          "name": "acq-postgres"
        }
      },
      "retryOnFail": true,
      "maxTries": 1,
      "waitBetweenTries": 2000,
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "Anything Claimed?-c",
              "leftValue": "={{ !!$json.outreach_id }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true
      },
      "id": "wf47-02",
      "name": "Anything Claimed?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [
        700,
        300
      ],
      "notes": "alwaysOutputData emits one empty item when the claim returns nothing; this keeps it out of the loop.",
      "notesInFlow": false
    },
    {
      "parameters": {},
      "id": "wf47-03",
      "name": "Nothing To Send",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        920,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.base_url }}/api/sendText",
        "options": {
          "timeout": 45000,
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": true
            }
          }
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ session: $json.session, chatId: $json.chat_id, text: $json.message }) }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth"
      },
      "id": "wf47-04",
      "name": "WAHA Send Text",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1140,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "REPLACE_WAHA",
          "name": "waha-api-key"
        }
      },
      "onError": "continueRegularOutput",
      "notes": "Never retried: a timed-out send may have been delivered.",
      "notesInFlow": false
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "const claim = $('Claim Next Message').first().json;\nconst r = $input.first().json || {};\nconst status = Number(r.statusCode || 0);\nconst body = r.body ?? r.data ?? {};\nconst id = body && (typeof body.id === 'string' ? body.id : body.id && (body.id._serialized || body.id.id));\nconst ok = status >= 200 && status < 300 && !!id;\nlet error = null;\nif (!ok) {\n  const detail = typeof body === 'string' ? body : JSON.stringify(body || r.error || {});\n  error = `HTTP ${status || 'no response'}: ${String(detail).slice(0, 300)}`;\n}\nreturn [{ json: { outreach_id: claim.outreach_id, ok, api_message_id: id || null, error } }];"
      },
      "id": "wf47-05",
      "name": "Read WAHA Answer",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1360,
        300
      ]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT acq.record_whatsapp_result($1::uuid, $2::boolean, $3, $4) AS result",
        "options": {
          "queryReplacement": "={{ [ $json.outreach_id, $json.ok, $json.api_message_id || '', $json.error || '' ] }}"
        }
      },
      "id": "wf47-06",
      "name": "Record Result",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1580,
        300
      ],
      "credentials": {
        "postgres": {
          "id": "REPLACE_PG",
          "name": "acq-postgres"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 2000
    }
  ],
  "connections": {
    "Every 2 Minutes": {
      "main": [
        [
          {
            "node": "Claim Next Message",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Claim Next Message": {
      "main": [
        [
          {
            "node": "Anything Claimed?",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Anything Claimed?": {
      "main": [
        [
          {
            "node": "WAHA Send Text",
            "type": "main",
            "index": 0
          }
        ],
        [
          {
            "node": "Nothing To Send",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "WAHA Send Text": {
      "main": [
        [
          {
            "node": "Read WAHA Answer",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Read WAHA Answer": {
      "main": [
        [
          {
            "node": "Record Result",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "saveManualExecutions": true,
    "saveDataErrorExecution": "all",
    "saveDataSuccessExecution": "all",
    "errorWorkflow": "ACQ 00 \u2014 Error Handler"
  },
  "active": false,
  "meta": {
    "acqWorkflowKey": "wf47"
  }
}
