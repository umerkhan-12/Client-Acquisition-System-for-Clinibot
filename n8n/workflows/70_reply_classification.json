    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO acq.approvals (kind, lead_id, reply_id, title, payload, ai_confidence)\nVALUES (\n  CASE\n    WHEN $5 = 'ASKING_PRICE'   THEN 'PRICING_QUESTION'::acq.approval_kind\n    WHEN $5 = 'WRONG_PERSON'   THEN 'DATA_CONFLICT'::acq.approval_kind\n    WHEN $5 = 'NEEDS_MORE_INFO' THEN 'REPLY_DRAFT'::acq.approval_kind\n    ELSE 'LOW_CONFIDENCE_CLASSIFICATION'::acq.approval_kind\n  END,\n  $1::uuid, $2::uuid, $3, $4::jsonb, $6::numeric)\nRETURNING id",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id, $json.reply_id, ('Reply needs a human: ' + $json.class), JSON.stringify({ class: $json.class, reason: $json.escalation_reason, questions: $json.extracted_questions, draft: $json.suggested_reply }), $json.class, $json.confidence ] }}"
        }
      },
