    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT acq.apply_opt_out('EMAIL',\n         (SELECT from_email::text FROM acq.replies WHERE id = $1::uuid),\n         'OPT_OUT_REQUEST', 'REPLY', $2::uuid, $3::jsonb) AS suppressed",
        "options": {
          "queryReplacement": "={{ [ $json.reply_id, $json.lead_id, JSON.stringify({ quote: $json.opt_out_quote, class: $json.class }) ] }}"
        }
      },
      "id": "wf70-07",
      "name": "Apply Opt-Out",
