                },
                "conditions": [
                  {
                    "id": "Route Outcome-3",
                    "leftValue": "={{ $('Interpret Classification').first().json.route }}",
                    "rightValue": "NEGATIVE",
                    "operator": {
                      "type": "string",
                      "operation": "equals"
                    }
                  }
                ],
                "combinator": "and"
              },
              "renameOutput": true,
              "outputKey": "NEGATIVE"
