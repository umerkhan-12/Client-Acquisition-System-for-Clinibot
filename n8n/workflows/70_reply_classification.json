    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH moved AS (\n  SELECT acq.transition_lead($1::uuid, 'LATER', $2, 'AI', $3) AS r\n)\nUPDATE acq.leads\n   SET next_follow_up_at = now() + make_interval(days => GREATEST($4::int, 30))\n WHERE id = $1::uuid",
        "options": {
          "queryReplacement": "={{ [ $json.lead_id, ('later:' + $json.class), $execution.id, ($json.revisit_after_days || 90) ] }}"
        }
      },
