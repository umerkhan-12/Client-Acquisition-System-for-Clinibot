# Everything here is regenerated by ./run_all.sh; only the captured logs,
# the report and its figures are worth keeping under version control.
results/*/
Files/pic_original.bmp
__pycache__/
*.zip

# The repository root ignores *.log, but these logs ARE the evidence that
# each task actually ran, so re-include them.
!results/*.log
known_iv

# Intermediates from building a downscaled copy of the report (used to test
# whether the PDF could be emailed as an inline attachment - it could not).
report/img_lite/
report/report_lite.html
report/*_compact.pdf
